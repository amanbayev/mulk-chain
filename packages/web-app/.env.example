# Public API origin used by the browser. Leave empty to hit this app's /api/v1 BFF.
NEXT_PUBLIC_API_BASE_URL=

# When set, Next.js BFF proxies /api/v1/* to the Hono gateway (packages/core-backend).
CORE_BACKEND_URL=http://127.0.0.1:8787

# Wallet / chain
NEXT_PUBLIC_RPC_URL=/api/rpc
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.arbiscan.io

# Server-side RPC used by /api/rpc (do not expose the Alchemy key to NEXT_PUBLIC_*)
ARBITRUM_SEPOLIA_RPC=
ARBITRUM_SEPOLIA_RPC_FALLBACK=https://sepolia-rollup.arbitrum.io/rpc
ANVIL_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optional live EnforcementController (3-of-5). Empty = simulated board.
NEXT_PUBLIC_ENFORCEMENT_ADDRESS=
NEXT_PUBLIC_ENFORCEMENT_CONTROLLER_ADDRESS=
NEXT_PUBLIC_MULK_TOKEN_ADDRESS=
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_GOV_ORACLE=
NEXT_PUBLIC_GOV_ORACLE_ADDRESS=
NEXT_PUBLIC_GOV_ORACLE_BRIDGE=
NEXT_PUBLIC_BATCH_AUCTION_ENGINE=
NEXT_PUBLIC_YIELD_VAULT=

# Demo session
NEXT_PUBLIC_DEFAULT_INVESTOR_ID=inv-001
NEXT_PUBLIC_ADMIN_API_KEY=

# Neon Postgres (leave empty to use in-memory demo-store)
DATABASE_URL=

# Comma-separated compliance officer wallets. Empty = any connected wallet in non-production.
ADMIN_WALLETS=
ADMIN_API_KEY=
