# Copy to repo-root `.env` (Foundry loads CWD) or `packages/contracts/.env`.
# Never commit real keys.

# --- Arbitrum Sepolia ---
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
PRIVATE_KEY=
# Etherscan API V2 key (also used for Arbitrum Sepolia verification).
ARBISCAN_API_KEY=

# Isolated Gov-Oracle EIP-712 signer (must not be an enforcement officer).
ORACLE_SIGNER_ADDRESS=

# EnforcementController is on-chain 3-of-5. ADMIN_1..3 are the names from the
# runbook; ADMIN_4 and ADMIN_5 are required by the contract (Trustee, Operations).
GOV_MULTISIG_ADMIN_1=
GOV_MULTISIG_ADMIN_2=
GOV_MULTISIG_ADMIN_3=
GOV_MULTISIG_ADMIN_4=
GOV_MULTISIG_ADMIN_5=
